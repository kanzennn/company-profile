# Absolute base URL used for metadata, Open Graph tags, robots.txt and sitemap.xml.
# Optional: production already defaults to https://kervzent.kanzen.my.id.
# Set this to override — preview/staging deployments need their own origin so
# crawlers and social cards don't resolve against the live domain.
NEXT_PUBLIC_SITE_URL=https://kervzent.kanzen.my.id
